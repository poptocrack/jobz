# France Travail — créer un compte sur https://francetravail.io,
# créer une application et activer l'API "Offres d'emploi v2".
FT_CLIENT_ID=
FT_CLIENT_SECRET=

# Adzuna — clé gratuite instantanée sur https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Optionnel : surcharge de la clé de recherche Algolia publique de WTTJ
# (uniquement si l'actuelle, embarquée dans le code, cesse de fonctionner).
# WTTJ_ALGOLIA_KEY=

# Newsletter (Brevo) — voir scripts/providers/brevo.py pour le détail.
# BREVO_API_KEY=
# BREVO_LIST_ID=
# BREVO_SENDER_EMAIL=
# BREVO_UNSUB_URL=
